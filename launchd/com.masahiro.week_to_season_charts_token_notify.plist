<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- cron-job.org 用 GitHub トークンの期限が近づいたら Slack DM で知らせる（期限の14/7/3/2/1日前、期限切れ後は毎日）
       事前準備: mkdir -p ~/.config/week_to_season_charts && 期限を token_expiry に1行、通知先を slack_to に1行（CRON_JOB_ORG.md の3節）
       登録: cp このファイル ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.masahiro.week_to_season_charts_token_notify.plist
       止める: launchctl bootout gui/$(id -u)/com.masahiro.week_to_season_charts_token_notify -->
  <key>Label</key><string>com.masahiro.week_to_season_charts_token_notify</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/masahiro/projects/week_to_season_charts/ops/token_expiry_notify.py</string>
  </array>
  <!-- 毎日 9:10 JST。Macがスリープ中だった場合は復帰後に1回実行される（nwp_chart_web の 9:05 とずらす） -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>10</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/masahiro/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/masahiro/.config/week_to_season_charts/notify.log</string>
  <key>StandardErrorPath</key><string>/Users/masahiro/.config/week_to_season_charts/notify.log</string>
</dict>
</plist>
